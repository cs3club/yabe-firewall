---
# vars/secrets.sops.yml.example
# This file documents the variables required by this project.
# NEVER commit vars/secrets.sops.yml (plaintext) to git.
#
# ── SOPS Encrypted Secrets Workflow ──────────────────────────────
# This project uses SOPS + age for encrypted secrets management.
# The encrypted file vars/secrets.sops.yml should NEVER be committed to git.
#
# Setup for a new team member:
# 1. Install age and sops:
#      sudo apt install -y age
#      # download sops from https://github.com/getsops/sops/releases
#      # download outside the repo directory to avoid it ending up in the repo
#
# 2. Generate your age key pair:
#      mkdir -p ~/.config/sops/age
#      age-keygen -o ~/.config/sops/age/keys.txt
#      chmod 600 ~/.config/sops/age/keys.txt
#
# 3. Share your public key (age1...) with the team lead so they can
#    add it to .sops.yaml and re-encrypt the secrets file for you.
#
# 4. Once added, decrypt the secrets file to work with it:
#      sops --decrypt vars/secrets.sops.yml > vars/secrets.yml
#
# 5. To re-encrypt after making changes:
#      sops --encrypt vars/secrets.yml > vars/secrets.sops.yml
#      # DO NOT commit vars/secrets.sops.yml to git
#
# ── Required Variables ────────────────────────────────────────────

# MikroTik admin account password
# This is the RouterOS user account Ansible logs in as.
mikrotik_admin_password: "CHANGEME"
